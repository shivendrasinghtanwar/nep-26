# macOS
.DS_Store
.AppleDouble
.LSOverride

# editor / scratch
.idea/
.vscode/
*.swp
*~
.cache/

# user / device drops — committed: the curated 8 waypoint images
# (downloaded once from Wikimedia, resized to 1280px). Drop in your own
# JPGs over them anytime — they'll be tracked as overrides.
# pics/*.jpg                # un-gitignored so the gallery works offline
pics/*.heic                 # phone-import format we don't ship
!pics/.gitkeep

# trip-side work code (use repos/ as a gitignore'd scratchpad if needed)
repos/*
!repos/.gitkeep

# python build artefacts (none expected, but defensive)
__pycache__/
*.pyc

# claude-code outputs (scratchpad, not part of dossier)
claude-code/outputs/*
!claude-code/outputs/.gitkeep

# Claude Code session-local state (user-specific, not part of project)
.claude/

# superpowers brainstorm caches (scratch, not part of project)
.superpowers/


# Node / Vite
node_modules/
dist/
.vite/
*.tsbuildinfo
